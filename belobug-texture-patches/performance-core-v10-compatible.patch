+extern "system" fn set_staging_buffer_size(_: Factory, size: u32) -> HRESULT {
+    // AvatarManz / cool_fox staging floor, bounded for 32 GiB hosts.
+    // This changes the scheduler's in-flight byte limit, not a reservation.
+    static FLOOR: std::sync::OnceLock<u64> = std::sync::OnceLock::new();
+    let floor = *FLOOR.get_or_init(|| {
+        v10_staging_floor(std::env::var("VICTORY_DSTORAGE_STAGING_MB").ok().as_deref())
+    });
+    tracing::info!(size, floor, "dstorage: staging buffer size");
+    if let Some(scheduler) = scheduler() {
+        scheduler.lock().staging = u64::from(size).max(floor);
+    }
+    S_OK
+}
+
+fn v10_staging_floor(value: Option<&str>) -> u64 {
+    value.and_then(|s| s.trim().parse::<u64>().ok()).unwrap_or(0).min(256) << 20
+}
+
+#[cfg(test)]
+#[test]
+fn v10_staging_floor_is_opt_in_and_bounded() {
+    assert_eq!(v10_staging_floor(None), 0);
+    assert_eq!(v10_staging_floor(Some("invalid")), 0);
+    assert_eq!(v10_staging_floor(Some("128")), 128 << 20);
+    assert_eq!(v10_staging_floor(Some("18446744073709551615")), 256 << 20);
+}
 
