+// V13: organize sparse memory work by root and byte coverage, not by
+// repeated shader write declarations. No GPU wait or title signal is moved.
+static V13_BATCH_STATS: [std::sync::atomic::AtomicU64; 6] =
+    [const { std::sync::atomic::AtomicU64::new(0) }; 6];
+
+fn v13_batch_enabled() -> bool {
