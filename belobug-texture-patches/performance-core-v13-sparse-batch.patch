+
+fn v13_snapshot_enabled() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var_os("VICTORY_V13_SNAPSHOT_PLAN").is_some_and(|v| v == "1"))
+        && sparse_cache_enabled()
+}
+
+// Emit the as-yet uncovered bytes in first-declaration order. Never round
+// to pages, bridge a hole, or reorder distinct title-memory addresses.
+fn v13_uncovered(ranges: &[(usize, usize)]) -> Vec<(usize, usize)> {
+    let mut covered = std::collections::BTreeMap::<usize, usize>::new();
+    let mut spans = Vec::new();
+    for &(at, len) in ranges {
+        let Some(end) = at.checked_add(len) else { continue; };
+        if len == 0 { continue; }
+        let first = covered.range(..=at).next_back()
+            .filter(|&(_, &b)| b >= at).map_or(at, |(&a, _)| a);
+        let touching: Vec<_> = covered.range(first..=end)
+            .map(|(&a, &b)| (a, b)).collect();
+        let (mut lo, mut hi, mut cursor) = (at, end, at);
+        for (a, b) in touching {
+            if cursor < a.min(end) { spans.push((cursor, a.min(end) - cursor)); }
+            cursor = cursor.max(b);
+            lo = lo.min(a);
+            hi = hi.max(b);
+            covered.remove(&a);
+        }
+        if cursor < end { spans.push((cursor, end - cursor)); }
+        covered.insert(lo, hi);
+    }
+    spans
+}
+
+#[cfg(test)]
+#[test]
+fn v13_coverage_is_exact_and_first_seen() {
+    assert_eq!(v13_uncovered(&[(10, 10), (5, 20), (12, 4), (30, 2)]),
+        vec![(10, 10), (5, 5), (20, 5), (30, 2)]);
+    let ranges = [(17, 15), (3, 5), (0, 40), (7, 3), (40, 4), (60, 2)];
+    let mut expected = Vec::new();
+    let mut seen = std::collections::HashSet::new();
+    for (a, n) in ranges { for i in a..a+n { if seen.insert(i) { expected.push(i); } } }
+    let got: Vec<_> = v13_uncovered(&ranges).into_iter().flat_map(|(a,n)| a..a+n).collect();
+    assert_eq!(got, expected);
+    assert!(v13_uncovered(&[(usize::MAX, 2), (3, 0)]).is_empty());
+}
+
+pub(crate) fn copy_back_group(group: &[(Arc<Shadow>, usize, usize)]) -> usize {
+    if v13_batch_enabled() && group.len() > 1 {
+        if let Some((root, sparse)) = group[0].0.sparse_root() {
+            if group.iter().all(|(s, a, n)| {
+                s.root_key() == root.root_key()
+                    && (*a as u64) >= root.start
+                    && a.checked_add(*n).is_some_and(|end| (end as u64) <= root.start.saturating_add(root.len))
+            }) {
+                let ranges: Vec<_> = group.iter().map(|(_, a, n)| (*a, *n)).collect();
+                return root.sparse_back_ranges(sparse, &ranges, true);
+            }
+        }
+    }
+    group.iter().map(|(s, a, n)| s.copy_back(*a, *n)).sum()
+}
+
+pub(crate) fn log_sparse_perf() {
+    let [ranges, lookups, bytes] = SPARSE_PERF.each_ref().map(|v| v.swap(0, Ordering::Relaxed));
+    tracing::info!(ranges, lookups, bytes, "sparse cache performance interval");
+    let [batches, pages, checked_bytes, changed_bytes, compare_us] =
+        READBACK_COMPARE.each_ref().map(|v| v.swap(0, Ordering::Relaxed));
+    tracing::info!(batches, pages, checked_bytes, changed_bytes, compare_us, "parallel sparse readback interval");
+    tracing::info!(duplicates = V7_PENDING_DUPLICATES.swap(0, Ordering::Relaxed), "V7 indexed pending interval");
+    let [roots, declarations, declared_bytes, unique_bytes, snapshot_hits, fallbacks] = V13_BATCH_STATS.each_ref().map(|v| v.swap(0, Ordering::Relaxed));
+    tracing::info!(roots, declarations, declared_bytes, unique_bytes, snapshot_hits, fallbacks, "V13 sparse work plan interval");
 }
 
