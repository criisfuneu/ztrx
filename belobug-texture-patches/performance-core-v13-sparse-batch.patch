+    fn sparse_back_ranges(&self, s: &Sparse, ranges: &[(usize, usize)], bulk: bool) -> usize {
+        let merged;
+        let spans = if bulk { merged = v13_uncovered(ranges); merged.as_slice() } else { ranges };
