+            V13_BATCH_STATS[1].fetch_add(ranges.len() as u64, Ordering::Relaxed);
+            V13_BATCH_STATS[2].fetch_add(ranges.iter().fold(0u64, |n, &(_, bytes)| n.saturating_add(bytes as u64)), Ordering::Relaxed);
+            V13_BATCH_STATS[3].fetch_add(len as u64, Ordering::Relaxed);
+        }
+        let mut before = s.before.lock().unwrap_or_else(|e| e.into_inner());
+        let start = self.start as usize;
+        let mut written = 0;
+        let mut title: Option<Vec<u8>> = None;
+        let cache = sparse_cache_enabled();
+        let mut skipped = 0u64;
+        // Compare large ranges across cores, before merging any modified bytes.
+        // The before lock serializes aliases of this root; tile sweeping is off.
+        // Only immutable reads occur in workers. The original merge and title
+        // writes below remain serial, in the original address order.
+        let permit = ReadbackPermit::try_take(len);
+        let compared = permit.as_ref().map(|_| {
+            let started = std::time::Instant::now();
+            let mut jobs = Vec::with_capacity(len.div_ceil(PAGE).min(32768));
+            for &(address, bytes) in spans {
+                self.each_tile(s, address, address + bytes, |at, data, n| {
+                    jobs.push((at, data as usize, n, std::sync::atomic::AtomicU8::new(0)));
+                });
+            }
+            let snapshots = &before.tiles;
+            crate::host::in_parallel(&jobs, 32, |chunk| {
+                for (at, data, n, status) in chunk {
+                    let Some(old) = snapshots.get(&(((*at - start) / PAGE) as u32)) else { continue };
+                    if cache && old.unchanged {
+                        status.store(1, Ordering::Relaxed);
+                        continue;
+                    }
+                    // SAFETY: mapping is live for this call, GPU is finished,
+                    // before lock excludes other readbacks of this sparse root.
