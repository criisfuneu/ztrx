-/// Merges GPU-modified bytes (`gpu_new != staging_old`) into `title` and syncs
+#[cfg(test)]
+#[test]
+fn v5_block_merge_matches_reference() {
+    for n in [0usize, 1, 7, 8, 63, 64, 65, 129, 4096] {
+        for stride in [1usize, 17, 67, 257] {
+            let mut title: Vec<u8> = (0..n).map(|i| (i % 251) as u8).collect();
+            let mut old = title.clone();
+            let mut host = old.clone();
+            for i in (0..n).step_by(stride) { host[i] ^= 0x55; }
+            for i in (0..n).step_by(13) { title[i] ^= 0x37; }
+            let mut expected = title.clone();
+            let mut h = host.clone();
+            let span = merge_gpu_writes(&mut expected, &mut h, &old);
+            assert_eq!(merge_gpu_writes_mut(&mut title, &mut host, &mut old), span);
+            assert_eq!(title, expected);
+            assert_eq!(host, h);
+            assert_eq!(old, expected);
+        }
+    }
+}
