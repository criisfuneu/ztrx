+// Adapted from the indexed table lookup experiment. Preserve first match.
+fn v11_indexed_tables() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var_os("VICTORY_V11_INDEXED_TABLES").is_some_and(|v| v == "1"))
+}
+
+fn v11_descriptor_index(keys: impl Iterator<Item = u32>) -> Vec<(u32, usize)> {
+    let mut index: Vec<_> = keys.enumerate().map(|(i, key)| (key, i)).collect();
+    index.sort_unstable();
+    index.dedup_by_key(|e| e.0);
+    index
+}
+
+fn v11_descriptor_lookup(index: &[(u32, usize)], key: u32) -> Option<usize> {
+    index.binary_search_by_key(&key, |e| e.0).ok().map(|i| index[i].1)
+}
+
+#[cfg(test)]
+#[test]
+fn v11_descriptor_index_keeps_first_match() {
+    for keys in [vec![], vec![3, 0, 3, 5, 1, 0, 100, 2], vec![u32::MAX, 8, 8]] {
+        let index = v11_descriptor_index(keys.iter().copied());
+        for key in (0..128).chain(std::iter::once(u32::MAX)) {
+            assert_eq!(v11_descriptor_lookup(&index, key), keys.iter().position(|&k| k == key));
+        }
+    }
+}
 
