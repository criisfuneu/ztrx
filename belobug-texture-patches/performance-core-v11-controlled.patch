+// Exact contiguous fill joining, without changing allocation or queue order.
+fn v11_join_fill(d: usize, s: usize, n: usize, dst: usize, src: usize, len: usize) -> Option<usize> {
+    let total = n.checked_add(len)?;
+    (n > 0 && len > 0 && total <= 128 * 1024
+        && d.checked_add(n) == Some(dst) && s.checked_add(n) == Some(src)
+        && d.checked_add(total).is_some() && s.checked_add(total).is_some()).then_some(total)
+}
+
+#[cfg(test)]
+#[test]
+fn v11_join_fill_is_exact_and_bounded() {
+    assert_eq!(v11_join_fill(100, 200, 16, 116, 216, 16), Some(32));
+    assert_eq!(v11_join_fill(100, 200, 16, 117, 216, 16), None);
+    assert_eq!(v11_join_fill(100, 200, 16, 116, 215, 16), None);
+    assert_eq!(v11_join_fill(100, 200, 131072, 131172, 131272, 1), None);
+    assert_eq!(v11_join_fill(usize::MAX, 200, 1, 0, 201, 1), None);
+}
+
+/// Runs `f` on pieces of `list`, of `least` items or more, on some threads.
+pub(crate) fn in_parallel<T: Sync>(list: &[T], least: usize, f: impl Fn(&[T]) + Sync) {
+    static THREADS: std::sync::OnceLock<usize> = std::sync::OnceLock::new();
+    let threads_limit = *THREADS.get_or_init(|| {
+        std::env::var("VICTORY_V11_COPY_THREADS").ok().and_then(|s| s.parse::<usize>().ok()).unwrap_or(6).clamp(1, 8)
+    });
+    if threads_limit == 1 || list.len() <= least {
+        return f(list);
+    }
+    // Small pieces, taken in turn: they are not equally long to do.
+    let piece = (list.len() / (threads_limit * 8)).max(least);
+    let next = std::sync::atomic::AtomicUsize::new(0);
+    let work = || {
+        loop {
+            let from = next.fetch_add(piece, Ordering::Relaxed);
+            if from >= list.len() {
+                break;
+            }
+            f(&list[from..(from + piece).min(list.len())]);
+        }
+    };
+    let threads = threads_limit.min(list.len().div_ceil(piece));
+    std::thread::scope(|s| {
+        for _ in 1..threads {
+            s.spawn(work);
+        }
+        work();
     });
 }
 
