+// Backport of upstream eb5061c, credited to the upstream authors.
+// V11 switch leaves the original blend state and cache identity available.
+/// Integer render target formats: D3D12 cannot blend into them.
+fn integer_format(f: DXGI_FORMAT) -> bool {
+    matches!(f,
+        DXGI_FORMAT_R32G32B32A32_UINT | DXGI_FORMAT_R32G32B32A32_SINT
+        | DXGI_FORMAT_R32G32B32_UINT | DXGI_FORMAT_R32G32B32_SINT
+        | DXGI_FORMAT_R16G16B16A16_UINT | DXGI_FORMAT_R16G16B16A16_SINT
+        | DXGI_FORMAT_R32G32_UINT | DXGI_FORMAT_R32G32_SINT
+        | DXGI_FORMAT_R10G10B10A2_UINT
+        | DXGI_FORMAT_R8G8B8A8_UINT | DXGI_FORMAT_R8G8B8A8_SINT
+        | DXGI_FORMAT_R16G16_UINT | DXGI_FORMAT_R16G16_SINT
+        | DXGI_FORMAT_R32_UINT | DXGI_FORMAT_R32_SINT
+        | DXGI_FORMAT_R8G8_UINT | DXGI_FORMAT_R8G8_SINT
+        | DXGI_FORMAT_R16_UINT | DXGI_FORMAT_R16_SINT
+        | DXGI_FORMAT_R8_UINT | DXGI_FORMAT_R8_SINT)
+}
+
+fn host_blend(blend: &D3D12_BLEND_DESC, targets: &D3D12_RT_FORMAT_ARRAY) -> D3D12_BLEND_DESC {
+    let count = (targets.NumRenderTargets as usize).min(8);
+    let per_target = blend.IndependentBlendEnable.as_bool();
+    let blends = |i: usize| blend.RenderTarget[if per_target { i } else { 0 }].BlendEnable.as_bool();
+    if !(0..count).any(|i| integer_format(targets.RTFormats[i]) && blends(i)) {
+        return *blend;
+    }
+    let mut host = *blend;
+    if !per_target {
+        host.IndependentBlendEnable = true.into();
+        host.RenderTarget = [blend.RenderTarget[0]; 8];
+    }
+    for i in 0..count {
+        if integer_format(targets.RTFormats[i]) {
+            host.RenderTarget[i].BlendEnable = false.into();
+        }
+    }
+    host
+}
+
+fn v11_blend(blend: &D3D12_BLEND_DESC, targets: &D3D12_RT_FORMAT_ARRAY) -> D3D12_BLEND_DESC {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    if *ON.get_or_init(|| std::env::var_os("VICTORY_V11_INTEGER_BLEND").is_some_and(|v| v == "1")) {
+        host_blend(blend, targets)
+    } else {
+        *blend
+    }
+}
+
+#[cfg(test)]
+#[test]
+fn v11_integer_target_blend_keeps_float_targets() {
+    let mut b = GraphicsState::default().blend;
+    b.RenderTarget[0].BlendEnable = true.into();
+    let mut t = D3D12_RT_FORMAT_ARRAY::default();
+    t.NumRenderTargets = 2;
+    t.RTFormats[0] = DXGI_FORMAT_R8G8B8A8_UNORM;
+    t.RTFormats[1] = DXGI_FORMAT_R8_UINT;
+    let result = host_blend(&b, &t);
+    assert!(result.RenderTarget[0].BlendEnable.as_bool());
+    assert!(!result.RenderTarget[1].BlendEnable.as_bool());
+}
