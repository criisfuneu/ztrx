+#[cfg(windows)]
+fn released_views_since(seen: u64) -> (Option<Vec<(u32, u32)>>, u64) {
+    let views = VIEWS.lock().unwrap_or_else(|e| e.into_inner());
+    let now = views.release_count;
+    let n = now.saturating_sub(seen);
