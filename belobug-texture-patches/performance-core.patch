+// Performance Core: lock time, queue calls/time, blocking waits/time,
+ // already-completed fences, parallel refresh batches/ranges.
+static PERF_CORE: [std::sync::atomic::AtomicU64; 8] =
+    [const { std::sync::atomic::AtomicU64::new(0) }; 8];
+
+fn perf_add(index: usize, value: u64) {
+    PERF_CORE[index].fetch_add(value, Ordering::Relaxed);
+}
