+fn perf_parallel_refresh() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var_os("VICTORY_PERF_PARALLEL_REFRESH").is_some_and(|v| v == "1"))
+}
+
+fn batch_timing() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| cfg!(feature = "diagnostics") &&
+        std::env::var_os("VICTORY_GPU_TIMING_BATCH").is_some_and(|v| v == "1"))
+}
