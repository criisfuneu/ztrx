-/// Runs `f` on pieces of `list`, of `least` items or more, on some threads.
+// Inspired by DexNom/VIctory commit 5f4c3df44197eb03b82205d2da871ded8d0ccf16.
+static DEXNOM_FILLS: [std::sync::atomic::AtomicU64; 3] =
+    [const { std::sync::atomic::AtomicU64::new(0) }; 3];
+
+fn dexnom_fills_enabled() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    !cfg!(test) && *ON.get_or_init(|| std::env::var_os("VICTORY_PERF_DEXNOM_FILLS").is_some_and(|v| v == "1"))
+}
+
+// Require monotonically increasing, disjoint scratch destinations and
+// no source intersecting their span. Otherwise preserve serial order.
+fn independent_upload_fills(fills: &[(usize, usize, usize)]) -> bool {
+    let Some(&(first, _, _)) = fills.first() else { return false; };
+    let mut end = first;
+    for &(dst, _, len) in fills {
+        let Some(next) = dst.checked_add(len) else { return false; };
+        if dst < end { return false; }
+        end = next;
+    }
+    fills.iter().all(|&(_, src, len)| {
+        src.checked_add(len).is_some_and(|last| src >= end || last <= first)
+    })
+}
+
+#[cfg(test)]
+#[test]
+fn upload_fill_independence_checks_aliases_and_overflow() {
+    assert!(independent_upload_fills(&[(100, 1000, 8), (108, 2000, 8)]));
+    assert!(!independent_upload_fills(&[(100, 1000, 8), (104, 2000, 8)]));
+    assert!(!independent_upload_fills(&[(100, 1000, 8), (108, 100, 8)]));
+    assert!(!independent_upload_fills(&[(usize::MAX, 1000, 8)]));
+}
