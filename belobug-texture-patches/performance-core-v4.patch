+// Comparison-only workers: GPU completion and original serial write-back
+// ordering remain mandatory. Do not keep mapped addresses beyond a call.
+static READBACK_COMPARE: [std::sync::atomic::AtomicU64; 5] =
+    [const { std::sync::atomic::AtomicU64::new(0) }; 5];
+static READBACK_WORKERS: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+struct ReadbackPermit;
+impl ReadbackPermit {
+    fn try_take(len: usize) -> Option<Self> {
+        static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+        if cfg!(test) || sweeps() != 0 || len < 16 * 1024 * 1024
+            || !*ON.get_or_init(|| std::env::var_os("VICTORY_PERF_PARALLEL_READBACK").is_some_and(|v| v == "1"))
+        {
+            return None;
+        }
+        READBACK_WORKERS.compare_exchange(false, true, Ordering::AcqRel, Ordering::Relaxed).ok()?;
+        Some(Self)
+    }
+}
+impl Drop for ReadbackPermit {
+    fn drop(&mut self) {
+        READBACK_WORKERS.store(false, Ordering::Release);
+    }
+}
 
